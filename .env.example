# Copy to repo-root `.env` (gitignored):
#   cp .env.example .env
# Then fill keys from: supabase status (local) or the Supabase Cloud dashboard.
#
# Backend loads ../.env and .env automatically (go run / air).
# Frontend (Vite dev): optional VITE_* in frontend/.env.local as fallback;
# normally the SPA loads SUPABASE_* via GET /api/config from the backend.
#
# Docker / production runtime (container env — not baked into the image):
#   DATABASE_URL, SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
#   optional: HTTP_ADDR (image default :8080), CORS_ORIGINS

# --- Local Supabase (from `supabase status` after `supabase start`) ----------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

HTTP_ADDR=:3000

# Comma-separated browser origins for CORS (Vite dev). Empty = localhost:5173 defaults.
# Same-origin Docker deploys typically leave this empty / unused.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional frontend fallback if /api/config is unreachable (Vite-only)
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=

# OAuth providers (used by supabase/config.toml via env() for local; Cloud dashboard for prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Cloud Supabase (production container) -----------------------------------
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_ANON_KEY=<anon>
# SUPABASE_SERVICE_ROLE_KEY=<service_role>
