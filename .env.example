# Copy to repo-root `.env` (gitignored):
#   cp .env.example .env
# Then fill keys from: supabase status
#
# Backend loads ../.env and .env automatically (go run / air).
# Frontend: put VITE_* into frontend/.env.local

# Local Supabase (from `supabase status` after `supabase start`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

HTTP_ADDR=:3000

# Frontend (Vite)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# OAuth providers (used by supabase/config.toml via env())
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
